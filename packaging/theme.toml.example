[colors]
base = "#1e1e2e"
mantle = "#181825"
crust = "#11111b"
text = "#cdd6f4"
subtext = "#a6adc8"
accent = "#cba6f7"
cursor_bg = "#313244"
sel_bg = "#45475a"
sel_inactive = "#242535"
ok = "#a6e3a1"
warn = "#f9e2af"
err = "#f38ba8"
busy = "#89b4fa"
border = "#45475a"
border_strong = "#585b70"
blue = "#89b4fa"
teal = "#94e2d5"
green = "#a6e3a1"
mauve = "#cba6f7"
yellow = "#f9e2af"
red = "#f38ba8"
pink = "#f5c2e7"
raised = "#313244"
disabled = "#6c7086"
accent_ink = "#11111b"

# 三列背景有别名：left = mantle（左列）、middle = base（中列）、right = crust（右列）。
# 保存即生效，无需重启。字体也可换（可选）：指向任意字体文件，系统字体也行；
# 图标会自动回退内置 Maple（nerd 补丁），不会变豆腐块：
# [font]
# path = "/usr/share/fonts/noto/NotoSansMono-Regular.ttf"