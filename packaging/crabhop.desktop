[Desktop Entry]
Type=Application
Name=CrabHop
GenericName=File Manager
Comment=Native, keyboard-first file manager / 原生键盘优先的文件管理器
Exec=crabhop %F
Icon=crabhop
Terminal=false
# A main category first (desktop-file-validate asks for one), the file-manager role beside it.
Categories=Utility;FileManager;
MimeType=inode/directory;
Keywords=crabhop;file;manager;files;
StartupWMClass=crabhop